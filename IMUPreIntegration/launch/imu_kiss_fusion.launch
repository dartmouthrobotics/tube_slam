<launch>
      <arg name="bagfile" default=""/>
      <arg name="use_sim_time" default="true"/>
      <arg name="transpose_extrinsic" default="false"/>
      
      <param name="/use_sim_time" value="$(arg use_sim_time)"/>
      <param name="dummy_mkdir" command="mkdir -p /home/xiaoming/2026_slam/data /home/xiaoming/2026_slam/pointcloud" />

      <!-- TF: world -> odom (identity) -->
      <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_odom_tf" 
            args="0 0 0 0 0 0 world odom" />

      <!-- TF: sonar_3d -> MiniAHRS (extrinsic calibration) -->
      <node pkg="tf2_ros" type="static_transform_publisher" name="sonar_to_imu_tf" 
            args="0 0 0 1.56107 0.0747417 3.12156 sonar_3d MiniAHRS" />

      <!-- KISS-ICP -->
      <node pkg="kiss_icp" type="odometry_node" name="kiss_icp_node" output="screen">
            <remap from="/pointcloud_topic" to="/sonar_3d/point_cloud"/>
            <param name="odom_frame" value="odom"/>
            <param name="base_frame" value="sonar_3d"/>
            <param name="visualize" value="true"/>
            <param name="max_range" value="10.0"/>
            <param name="min_range" value="0.5"/>
      </node>

      <!-- IMU + KISS-ICP Fusion -->
      <node pkg="imu_preintegration" type="imu_pre_integration_node.py" 
            name="imu_preintegration_node" output="screen" required="true">
            <param name="~transpose_extrinsic" value="$(arg transpose_extrinsic)"/>
      </node>

      <!-- Trajectory comparison (saves plots on shutdown) -->
      <node pkg="imu_preintegration" type="trajectory_compare.py"
            name="trajectory_compare" output="screen"/>

      <!-- Bag playback -->
      <node if="$(eval bagfile != '')" 
            pkg="rosbag" type="play" name="rosbag_play"
            args="--clock $(arg bagfile)" output="screen"/>
            
      <!-- RViz -->
      <node pkg="rviz" type="rviz" name="rviz" 
            args="-d $(find imu_preintegration)/rviz/rviz.rviz" />

</launch>




